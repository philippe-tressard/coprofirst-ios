#
# Versions ÉPINGLÉES de l'outillage — la seule liste. Le poste les installe par
# Homebrew (README, « Outillage ») ; la CI télécharge exactement celles-ci et vérifie
# leur empreinte (scripts/installer-outillage-ci.sh). Une montée = ces lignes, dans
# un commit qui le dit.
XCODEGEN_VERSION=2.46.0
# Xcode : un MINIMUM, pas une version épinglée (#369) — le plus ancien PROUVÉ, celui de la CI
# (« Xcode du runner » : 26.6 le 23/11/2026). Plus ancien n'est pas mesuré. scripts/generer-projet.sh
# refuse un Xcode en dessous, INCONNU s'il est illisible. Verrou : quand macos-latest passera à
# Xcode 27, le code sous `#if compiler(>=6.4)` (Posture.swift) se compilera en CI d'office.
XCODE_MINIMUM=26.6
SWIFTLINT_VERSION=0.65.1
SWIFT_FORMAT_VERSION=604.0.0
# REUSE : pip install "reuse[charset-normalizer]==$REUSE_VERSION" — la CI l'installe à
# cette version (scripts/controles-distants.sh), le poste par pipx ; une autre : INCONNU.
REUSE_VERSION=6.2.0
# Le système des simulateurs de la CI (#287) : iOS, tvOS et watchOS du runner, les trois
# à 26.5 le 18/11/2026 (« Simulateur retenu » des jobs de main). La CI le joue
# (tests-simulateur.sh) ; le poste le joue sur demande, `OS_SIMULATEUR=ci`, et chaque
# passage dit au résumé le système joué et celui-ci. Le runner ne l'a plus : INCONNU.
OS_SIMULATEUR_CI=26.5
